{
  "manifest_version": 3,
  "name": "Tag Mapper Debugger",
  "version": "2.0.0",
  "description": "Comprehensive tag discovery tool - tracks all pixels, floodlights, and analytics across domains",
  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["debugger.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
